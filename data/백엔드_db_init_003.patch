+-- 020_seed_questions.sql · 문진 8문항 + 후속 1문항 · 선택지 44개
+-- 출처 : 서비스플로우.md 1-C
+-- option_key는 type_rules의 입력값이다. 한번 정하면 바꾸지 않는다.
+
+INSERT INTO questions (code, ordinal, title, hint, input_kind, parent_code) VALUES
+ ('q1',1,'지금 어떤 연락을 받으셨나요?','어디서 연락이 왔는지에 따라 가야 할 곳이 달라집니다.','단일선택',NULL),
+ ('q2',2,'어떤 입금 때문인지 알고 계신가요?','방금 받으신 연락에서 어느 입금이 문제인지 알려주던가요?','단일선택',NULL),
+ ('q3',3,'그 돈은 어떤 거래로 받으신 건가요?','사실 그대로 고르시면 됩니다.','단일선택',NULL),
+ ('q4',4,'무엇을 넘기셨나요?','넘기신 것에 따라 증거를 받을 곳이 달라집니다.','단일선택',NULL),
+ ('q5',5,'어떻게 전달하셨나요?','','단일선택',NULL),
+ ('q6',6,'들어온 금액이 약속한 금액과 같았나요?','','단일선택',NULL),
+ ('q6f',7,'상대가 그 돈을 돌려달라고 하던가요?','','단일선택','q6'),
+ ('q7',8,'입금자 이름이 대화 상대와 같았나요?','','단일선택',NULL),
+ ('q8',9,'다음 중 해당하는 것이 있나요?','해당하는 것을 모두 골라 주세요. 하나라도 있으면 문서를 만들어 드리지 않습니다.','복수선택',NULL);
+
+INSERT INTO question_options
+  (question_code, ordinal, option_key, label, axis, axis_value, risk_flag, stop_here, warning) VALUES
+-- Q1 트랙
+ ('q1',1,'bank','은행에서 계좌가 정지됐다고 연락이 왔습니다','트랙','은행',NULL,false,''),
+ ('q1',2,'police','경찰에서 조사받으러 오라고 연락이 왔습니다','트랙','경찰',NULL,false,''),
+ ('q1',3,'alert','아직 연락은 없는데 이상한 게 보입니다','트랙','경보',NULL,false,''),
+ ('q1',4,'civil','소송 서류나 내용증명이 왔습니다','트랙','민사',NULL,false,''),
+ ('q1',5,'dunno','잘 모르겠습니다','없음',NULL,NULL,false,''),
+-- Q2 사건 특정
+ ('q2',1,'told','은행(또는 수사관)이 문제가 된 입금 건을 알려줬습니다','없음',NULL,NULL,false,''),
+ ('q2',2,'guess','알려주지는 않았는데 짚이는 거래가 있습니다','없음',NULL,NULL,false,''),
+ ('q2',3,'none','알려주지도 않았고 짚이는 거래도 없습니다','없음',NULL,NULL,false,
