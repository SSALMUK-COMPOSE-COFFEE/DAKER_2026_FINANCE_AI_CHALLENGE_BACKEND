+('상황',
+ '해외에서 일하는 가족이 보낸 돈을 시중은행이 아니라 사설 환전소를 통해 국내 계좌로 받아 온 경우다. 관측 사례에서는 중국에서 근무하는 배우자의 월급 월 500만~600만원을 3년 넘게 그렇게 받았고, 그 돈이 가족의 생활비였다. 2026년 6월 15일 계좌가 보이스피싱 피해금 연루를 이유로 지급정지되면서 당장 생계가 막혔다. 반복적이고 정기적인 입금이라는 점이 이 유형의 겉모습이다.'),
+('쟁점',
+ '이의제기를 하려면 돈이 들어온 정당한 이유를 설명해야 하는데, 설명하는 순간 금융당국에 등록되지 않은 사설 환전소를 통해 해외 자금을 들여온 사실이 드러난다. 이는 외국환거래법 위반, 이른바 환치기에 해당한다. 보이스피싱 혐의를 벗으려다 별건으로 과태료나 형사처벌을 받을 수 있는 구조다. T12와 같은 자기부죄 딜레마이며, 목적물이 외화라는 점만 다르다.'),
+('인정된것',
+ '아래는 확정된 처분 결과가 아니라 실무에서 유리하게 본 정황이다. 환전소 직원과 주고받은 메신저 대화는 소명 자료가 될 수 있다. 다만 캡처 화면만으로는 부족하고, 대화 상대의 인적사항이나 계좌번호가 연계되어야 하며, 출입국 기록과 재직증명서, 급여명세서 같은 객관적 자료가 반드시 함께 뒷받침되어야 증거 효력을 인정받는다. 즉 정당한 월급이었다는 주장은 대화 기록이 아니라 공식 서류가 떠받친다. 이의신청 자체는 서류가 다소 미흡해도 빠르게 접수하는 편이 유리하다는 것이 공통된 조언이다. 통지를 받은 뒤 사실상 2개월이 기한이다.'),
+('기각된것',
+ '이의신청이 한 번 거부되면 통상 재신청이 되지 않는다. 첫 대응이 사실상 유일한 기회라는 뜻이며, 준비 없이 빨리 내는 것과 빠르게 제대로 내는 것은 다르다. 더 큰 문제는 소명 과정 자체가 위험하다는 점이다. 지급정지를 풀기 위해 자금 경위를 설명하다가 환치기 혐의가 드러나 수사기관으로 송치되거나, 보이스피싱에 대한 미필적 고의 여부로 조사를 받을 수 있다. 메신저 캡처만 모아 제출하는 것으로는 어느 쪽도 해결되지 않는다.'),
+('표현',
+ '이 유형에는 소명서 문안을 생성하지 않는다. 대신 다음을 안내한다. 첫째, 2개월 기한이 있어 시간이 촉박하다는 것. 둘째, 정당한 월급이었음을 보이려면 대화 기록만으로는 부족하고 출입국 기록과 재직 및 급여 서류가 결합되어야 한다는 것. 셋째, 그러나 그 서류를 어떻게 구성해 낼지는 환치기 혐의를 동시에 관리해야 하는 문제라 형사 전문 변호사의 조력을 먼저 받아야 한다는 것. 억울함을 푸는 것과 별건 처벌을 피하는 것을 같이 풀어야 하는 유형이다.')
+) AS s(section, body)
+WHERE d.source_url = 'https://lawtalknews.co.kr/article/E4ROMI59NY5Q';
+
+-- ══════════════ T14 · 대리송금·알바형 (차단 유형) ══════════════
+INSERT INTO case_digests (document_id, case_type_id, section, body, verified, verified_on)
+SELECT d.id, (SELECT id FROM case_types WHERE code='T14'), s.section, s.body, false, NULL
+FROM corpus_documents d, (VALUES
+('상황',
+ '자기 계좌로 돈을 받아 지시받은 다른 계좌로 다시 보내주는 일을 하다가 계좌가 묶인 경우다. 관측된 세 사례의 겉모습은 각각 다르지만 구조는 같다. 친구가 돈을 보낼 테니 특정 계좌로 송금해 달라고 부탁해 100만원을 옮긴 경우, 텔레그램에서 사이트 양방작업 이체 알바 홍보글을 보고 참여해 150만원과 250만원을 받아 여러 계좌로 나눠 보낸 경우, 불법 사금융업자에게 일당 20만원을 받기로 하고 채무자 상환금을 3일간 약 6,700만원 옮긴 경우다. 결과는 공통적으로 전 계좌 지급정지와 경찰 연락이었다.'),
+('쟁점',
+ '이 유형은 명의인이 돈을 단순히 받은 것이 아니라 직접 옮겼다. 부작위가 아니라 작위이므로 방어선이 근본적으로 다르다. 핵심 쟁점은 미필적 고의, 즉 범죄 자금일 가능성을 알면서도 용인했는지다. 사기방조죄는 구체적인 범행 내용을 몰랐더라도 범죄 가능성을 인식하면서 실행을 쉽게 했다면 성립할 수 있다. 특히 일을 시작하기 전에 통장이 지급정지될 수 있다는 설명을 듣고도 시작했다면, 그 사실 자체가 미필적 고의의 결정적 증거로 다뤄진다.'),
+('인정된것',
+ '아래는 확정된 처분 결과가 아니라 실무에서 유리하게 본 정황이다. 상대가 먼저 일을 제안했다는 점, 업무 내용을 채무자의 상환금 처리라고 설명한 대화가 남아 있다는 점, 문제를 안 뒤 즉시 일을 중단하고 상대를 차단했다는 점, 받은 돈을 전혀 사용하지 않고 그대로 보관하고 있다는 점, 경찰 연락 전에 스스로 자진 출석을 준비한 점이 유리한 사정으로 꼽혔다. 은행 이의제기 쪽에서는 친구와의 관계, 구체적인 부탁 내용, 전달 경위를 시간 순서로 정리한 상세 경위서가 반드시 필요하다는 것이 공통된 조언이다.'),
+('기각된것',
+ '거래내역 증명서와 통화 내역서만 내는 이의제기는 인용 가능성이 매우 낮다. 통화 기록만으로는 상대가 무슨 부탁을 했는지가 확인되지 않기 때문이다. 금융회사는 범죄 고의가 없었음을 객관적 자료로 명확히 증명해야 지급정지를 풀어 준다. 또 하나 중요한 함정이 있다. 계좌 정지 직후 담당 경찰서에 문의해 조회되는 내용이 없다는 답을 들어도 안심해서는 안 된다. 피해 구제 신청이 전산 등록되고 관할서로 배당되는 데 시차가 있을 뿐이며, 처리가 끝나면 정식 피의자 또는 참고인 조사 연락이 온다. 동종 전과가 있으면 기간이 오래 지났더라도 수법이 유사하다는 이유로 미필적 고의 인정과 양형에서 불리하게 작용한다.'),
+('표현',
+ '이 유형에는 소명서 문안을 생성하지 않는다. 겉모습이 무고한 판매자와 비슷해 보이지만 법적 지위가 다르기 때문이다. 대신 다음을 안내한다. 은행 이의제기와 형사 조사는 별개의 트랙이고 후자가 더 무겁다는 것, 경찰이 지금은 조회되는 것이 없다고 해도 곧 연락이 온다는 것, 그리고 자수나 자진 출석은 형을 반드시 줄여 주는 보증수표가 아니라 진술 방향과 제출 자료를 어떻게 구성하느냐가 결과를 좌우한다는 것이다. 초기 진술이 가장 중요하므로 그 전에 변호사와 상의해야 한다.')
+) AS s(section, body)
+WHERE d.source_url = 'https://lawtalknews.co.kr/article/V7STYMBG63W1';
+
+-- ══════════════ T16 · 접근매체 제공형 (차단 유형 · 명시적 배제) ══════════════
+INSERT INTO case_digests (document_id, case_type_id, section, body, verified, verified_on)
+SELECT d.id, (SELECT id FROM case_types WHERE code='T16'), s.section, s.body, false, NULL
+FROM corpus_documents d, (VALUES
+('상황',
+ '대출이나 고액 알바를 미끼로 통장, 체크카드, OTP, 신분증, 휴대폰 같은 접근매체를 남에게 넘긴 뒤 계좌가 묶인 경우다. 관측 사례에서는 대출을 해주겠다는 말에 계좌 정보와 OTP 카드, 신분증 사진을 넘겼더니 대출금 대신 지급정지 통보가 왔고, 다른 사례에서는 고액 알바 광고를 보고 만난 상대에게 카드와 휴대폰을 건넸는데 그것이 현금 인출과 상품권 구매에 쓰였다. 인접한 형태로 본인도 모르게 명의가 도용되어 휴대폰이 개통된 뒤 피의자로 조사받는 경우가 있다.'),
+('쟁점',
+ '이 유형은 지급정지 이의제기보다 형사 방어가 먼저다. 보이스피싱인 줄 몰랐더라도 불법적인 목적으로 접근매체를 넘긴 행위 자체가 전자금융거래법 위반에 해당한다. 토토 환전에 쓰이는 줄 알았다는 주장도 그 행위가 위법이라는 사실을 바꾸지 못한다. 명의도용을 주장하는 경우에는 쟁점이 또 달라져서, 도용 사실 자체를 객관적 자료로 입증해야 한다.'),
+('인정된것',
+ '아래는 확정된 처분 결과가 아니라 실무에서 유리하게 본 정황이다. 해야 할 일로 세 가지가 공통적으로 꼽혔다. 첫째, 속았다는 사실을 입증할 자료를 전부 보존하는 것이다. 대출을 제안한 사람과의 문자, 메신저 대화, 통화내역, 계좌 개설 지시 내용, 인증번호 요구, 신분증 사진 전송 내역을 삭제하지 않아야 한다. 둘째, 금융회사에 정식으로 이의제기를 하는 것이다. 공고일 기준 2개월 경과 전이 핵심 기한이다. 셋째, 상대 피해자가 아직 신고하지 않았더라도 본인이 먼저 사기 피해로 신고해 접수번호를 받아 두는 것이다. 전자금융거래법 위반은 초범이라면 기소유예 수준까지 방어를 시도해 볼 수 있다는 견해가 있다.'),
+('기각된것',
+ '가장 위험한 행동은 지급정지된 계좌에서 돈을 임의로 인출하는 것이다. 법원은 보이스피싱에 이용된 계좌로 들어온 돈을 명의인의 돈이 아니라 피해자에게 반환해야 할 돈으로 본다. 따라서 인출하면 횡령죄가 성립할 수 있고 손해배상 책임도 생긴다. 내 통장에 있는 내 돈이라는 생각으로 현금부터 찾는 것이 피해자에서 피의자로 자리를 바꾸는 경로다. 조사 단계의 진술도 위험하다. 명의도용을 주장한 사례에서는 조사 중 필체가 본인 것이 맞다고 인정한 진술이 서류상 명의자라는 사실을 고착시키는 치명적 실수로 지적됐다. 막연히 부인만 하는 것으로는 수사기관이 확보한 정황 증거를 무너뜨리지 못한다.'),
+('표현',
+ '이 유형에는 소명서 문안을 생성하지 않는다. 3자사기용 소명서 템플릿을 주면 사실과 다른 이의제기가 되어 통신사기피해환급법 제16조 위반으로 이어질 수 있고, 우리 산출물이 오히려 해가 된다. 대신 다음을 안내한다. 지급정지된 계좌에서 절대 돈을 뽑지 말 것, 상대와 주고받은 기록을 하나도 지우지 말 것, 2개월 기한이 있다는 것, 본인이 먼저 피해 신고를 해 두는 편이 유리하다는 것, 그리고 조사에서는 초기 진술 한 문장이 결과를 좌우하므로 변호인 참여를 요청하라는 것이다. 참고로 본인이 대화 당사자인 녹음은 상대 동의가 없어도 통신비밀보호법 위반이 아니다.')
+) AS s(section, body)
+WHERE d.source_url = 'https://lawtalknews.co.kr/article/257JK09933ZO';
diff --git a/db/init/100_build_packs.sql b/db/init/100_build_packs.sql
new file mode 100644
index 0000000..7628c89
--- /dev/null
+++ b/db/init/100_build_packs.sql
@@ -0,0 +1,69 @@
+-- 100_build_packs.sql · 유형별 프롬프트 팩 조립
+-- 여러 번 돌려도 안전하다 (ON CONFLICT DO UPDATE).
+--
+-- 넣는 규칙 :
+--   범위 안 유형(out_of_scope=false) → verified=true 인 digest만 넣는다.
+--   범위 밖 유형(out_of_scope=true)  → 미검수도 넣되 '차단 안내'로 성격을 명시한다.
+--     이 유형의 팩은 소명서를 쓰기 위한 근거가 아니라 왜 못 쓰는지를 설명하는 글이라
+--     원문 두께가 필요하지 않다.
+--
+-- token_count 는 글자 수다. 한글은 대략 글자당 1~2 토큰이므로 어림값으로만 쓴다.
+
+INSERT INTO snippet_packs (case_type_id, pack_text, token_count, built_at)
+SELECT
+  t.id,
+     '# 유형 ' || t.code || ' · ' || t.name || E'\n\n'
+  || CASE WHEN t.out_of_scope
+          THEN E'> **이 유형은 소명서를 생성하지 않는다.** 아래는 왜 생성하면 안 되는지에 대한 설명이며,\n'
+            || E'> 사용자에게는 안내와 전문가 연결만 제공한다.\n\n'
+          ELSE '' END
+  || '**어떤 유형인가** ' || t.description || E'\n\n'
+  || '**축** 구조=' || coalesce(t.structure,'-')
+     || ' / 목적물=' || coalesce(t.subject,'-')
+     || ' / 주로 가는 길=' || t.track
+     || ' / 위험도=' || t.risk_level
+     || ' / 코퍼스 관측 ' || t.observed_count || E'건\n\n'
+  || '---' || E'\n\n'
+  || coalesce(d.sections, E'(요약 자료 없음)\n')
+  || coalesce(r.reasons, '')
+  || E'\n---\n\n'
+  || E'**작성 규칙**\n'
+  || E'- 위 자료에 없는 날짜·금액·이름을 절대 만들어 내지 않는다.\n'
+  || E'- 문장마다 어느 자료에 근거했는지 밝힌다.\n'
+  || E'- "기각된 것"에 적힌 서술은 반복하지 않는다.\n'
+  || CASE WHEN t.out_of_scope
+          THEN E'- 이 유형에는 소명서 본문을 쓰지 않는다. 안내문만 출력한다.\n'
+          ELSE '' END,
+  length(
+     '# 유형 ' || t.code || ' · ' || t.name
+  || coalesce(d.sections,'') || coalesce(r.reasons,'')),
+  now()
+FROM case_types t
+LEFT JOIN LATERAL (
+  SELECT string_agg(
+           '## ' || CASE cd.section
+                      WHEN '인정된것' THEN '인정된 것'
+                      WHEN '기각된것' THEN '기각된 것 — 반드시 피할 것'
+                      WHEN '표현'     THEN '실제로 통한 표현'
+                      ELSE cd.section END
+           || E'\n' || cd.body || E'\n',
+           E'\n' ORDER BY array_position(
+             ARRAY['상황','쟁점','인정된것','기각된것','표현'], cd.section))
+         AS sections
+  FROM case_digests cd
+  WHERE cd.case_type_id = t.id
+    AND (cd.verified OR t.out_of_scope)
+) d ON true
+LEFT JOIN LATERAL (
+  SELECT E'\n## 반려된 사유 (이렇게 쓰면 거절된다)\n'
+         || string_agg('- ' || rr.reason
+              || CASE WHEN rr.avoid_how <> '' THEN ' → ' || rr.avoid_how ELSE '' END,
+              E'\n' ORDER BY rr.id) || E'\n'
+         AS reasons
+  FROM refusal_reasons rr WHERE rr.case_type_id = t.id
+) r ON true
+WHERE d.sections IS NOT NULL
+ON CONFLICT (case_type_id) DO UPDATE
+  SET pack_text = EXCLUDED.pack_text,
+      token_count = EXCLUDED.token_count,
+      built_at = now();
